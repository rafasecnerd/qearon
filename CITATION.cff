title: "Qearon: Autonomous Low-Level Audio Orchestrator and Diagnostic Engine for Linux"
version: 0.1.0
date-released: 2026-10-26
url: "https://github.com/rafasecnerd/qearon"
repository-code: "https://github.com/rafasecnerd/qearon"
keywords:
  - "linux-audio"
  - "alsa"
  - "pipewire"
